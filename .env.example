# Copy to .env.local and fill in. Never commit real values.

# Absolute origin used for canonical URLs and magic links.
SITE_URL=http://localhost:3000

# "true" only after Gate 6 (Baseline methodology, website review) is cleared.
# Until then every response carries X-Robots-Tag: noindex and a preview banner shows.
SITE_PUBLIC=false

# Show [PLACEHOLDER] roster profiles. Never set to true in production.
SHOW_PLACEHOLDERS=false

# 32 random bytes, base64. Encrypts application, takedown and ledger records at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=

# 32+ random bytes, base64. Signs Ledger sessions and magic links.
SESSION_SECRET=

# Where encrypted records are written. Must be persistent storage (see README: Storage).
DATA_DIR=.data

# Magic-link and custodian notices. "console" prints to the server log (development only).
MAIL_TRANSPORT=console
CUSTODIAN_EMAIL=custodian@example.invalid
